ENV=dev

DATABASE_URL=sqlite+aiosqlite:///./database.db

JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_123456789
JWT_ALG=HS256

ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14

REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

REFRESH_HASH_PEPPER=CHANGE_ME_PEPPER_123456

# --- Mail (Zoho SMTP) ---
MAIL_ENABLED=true
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USERNAME=your.mailbox@zohomail.eu
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_EMAIL=your.mailbox@zohomail.eu
SMTP_FROM_NAME=Booking
SMTP_TIMEOUT_SECONDS=30

# --- Outbox worker ---
OUTBOX_POLL_SECONDS=15
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=30

# --- Reservation links sent in mails ---
# Where the link points, i.e. the frontend.
APP_BASE_URL=http://localhost:3000
RESERVATION_LINK_TTL_DAYS=30
